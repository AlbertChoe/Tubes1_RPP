@prefix : <http://example.org/bmw#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


<http://example.org/bmw> rdf:type owl:Ontology .

### Classes

:BMWModel rdf:type owl:Class .
:Series rdf:type owl:Class .
:BodyType rdf:type owl:Class .
:Powertrain rdf:type owl:Class .
:Drivetrain rdf:type owl:Class .
:Feature rdf:type owl:Class .
:Performance rdf:type owl:Class .

:ElectricCar rdf:type owl:Class .
:HybridCar rdf:type owl:Class .
:PetrolCar rdf:type owl:Class .

:HighPerformanceCar rdf:type owl:Class .
:StandardCar rdf:type owl:Class .

:AdvancedADASCar rdf:type owl:Class .
:OffroadCapableSUV rdf:type owl:Class .

:iSeriesCar rdf:type owl:Class .
:ThreeSeriesCar rdf:type owl:Class .
:XSeriesCar rdf:type owl:Class .


### Object Properties

:hasSeries rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :Series .
:hasBodyType rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :BodyType .
:hasPowertrain rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :Powertrain .
:hasDrivetrain rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :Drivetrain .
:hasFeature rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :Feature .
:hasPerformance rdf:type owl:ObjectProperty ; rdfs:domain :BMWModel ; rdfs:range :Performance .


# Subclass Axioms

:Sedan rdfs:subClassOf :BodyType .
:SUV rdfs:subClassOf :BodyType .
:GranCoupe rdfs:subClassOf :BodyType .
:Coupe rdfs:subClassOf :BodyType .
:Convertible rdfs:subClassOf :BodyType .
:Hatchback rdfs:subClassOf :BodyType .

:Electric rdfs:subClassOf :Powertrain .
:Gasoline rdfs:subClassOf :Powertrain .
:PlugInHybrid rdfs:subClassOf :Powertrain .
:Diesel rdfs:subClassOf :Powertrain .
:Hybrid rdfs:subClassOf :Powertrain .

:RWD rdfs:subClassOf :Drivetrain .
:AWD rdfs:subClassOf :Drivetrain .
:FWD rdfs:subClassOf :Drivetrain .

:MSeries rdfs:subClassOf :Performance .
:MPerformance rdfs:subClassOf :Performance .
:Standard rdfs:subClassOf :Performance .


# EquivalentClass Axioms

:ElectricCar owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf ( :BMWModel [ owl:onProperty :hasPowertrain ; owl:someValuesFrom :Electric ] )
] .

:HybridCar owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf ( :BMWModel [ owl:onProperty :hasPowertrain ; owl:someValuesFrom :PlugInHybrid ] )
] .

:PetrolCar owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf ( :BMWModel [ owl:onProperty :hasPowertrain ; owl:someValuesFrom :Gasoline ] )
] .

:HighPerformanceCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:unionOf (
            [ owl:onProperty :hasPerformance ; owl:someValuesFrom :MSeries ]
            [ owl:onProperty :hasPerformance ; owl:someValuesFrom :MPerformance ]
        ) ]
    )
] .

:StandardCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasPerformance ; owl:someValuesFrom :Standard ]
    )
] .

:AdvancedADASCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasFeature ; owl:someValuesFrom :DrivingAssistancePro ]
    )
] .

:OffroadCapableSUV owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasBodyType ; owl:someValuesFrom :SUV ]
        [ owl:onProperty :hasFeature ; owl:someValuesFrom :xDrive ]
    )
] .

:iSeriesCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasSeries ; owl:someValuesFrom :iSeries ]
    )
] .

:ThreeSeriesCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasSeries ; owl:someValuesFrom :threeSeries ]
    )
] .

:XSeriesCar owl:equivalentClass [
    owl:intersectionOf (
        :BMWModel
        [ owl:onProperty :hasSeries ; owl:someValuesFrom :xSeries ]
    )
] .


# Disjointness Axioms

:SUV owl:disjointWith :Sedan .
:ElectricCar owl:disjointWith :PetrolCar .
:MSeries owl:disjointWith :MPerformance .
:MPerformance owl:disjointWith :Standard .
:MSeries owl:disjointWith :Standard .


# Individuals - Series

:iSeries rdf:type :Series .
:threeSeries rdf:type :Series .
:xSeries rdf:type :Series .
:fiveSeries rdf:type :Series .
:fourSeries rdf:type :Series .
:oneSeries rdf:type :Series .
:twoSeries rdf:type :Series .
:sixSeries rdf:type :Series .
:sevenSeries rdf:type :Series .
:eightSeries rdf:type :Series .
:zSeries rdf:type :Series .


# Individuals - Body Types

:Sedan rdf:type :BodyType .
:SUV rdf:type :BodyType .
:GranCoupe rdf:type :BodyType .
:Coupe rdf:type :BodyType .
:Convertible rdf:type :BodyType .
:Hatchback rdf:type :BodyType .


# Individuals - Powertrains

:Electric rdf:type :Powertrain .
:Gasoline rdf:type :Powertrain .
:PlugInHybrid rdf:type :Powertrain .
:Diesel rdf:type :Powertrain .
:Hybrid rdf:type :Powertrain .


# Individuals - Drivetrains

:RWD rdf:type :Drivetrain .
:AWD rdf:type :Drivetrain .
:FWD rdf:type :Drivetrain .


# Individuals - Features

:iDrive rdf:type :Feature .
:xDrive rdf:type :Feature .
:DrivingAssistance rdf:type :Feature .
:DrivingAssistancePro rdf:type :Feature .
:MSportSuspension rdf:type :Feature .
:PanoramicRoof rdf:type :Feature .


# Individuals - Performance

:Standard rdf:type :Performance .
:MPerformance rdf:type :Performance .
:MSeries rdf:type :Performance .


