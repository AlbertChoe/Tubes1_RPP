<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/bmw#"
     xml:base="http://example.org/bmw"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/bmw"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/bmw#hasBodyType -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasBodyType">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/bmw#hasDrivetrain -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasDrivetrain">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#Drivetrain"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/bmw#hasFeature -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasFeature">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/bmw#hasPerformance -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasPerformance">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#Performance"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/bmw#hasPowertrain -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasPowertrain">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/bmw#hasSeries -->

    <owl:ObjectProperty rdf:about="http://example.org/bmw#hasSeries">
        <rdfs:domain rdf:resource="http://example.org/bmw#BMWModel"/>
        <rdfs:range rdf:resource="http://example.org/bmw#Series"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/bmw#AWD -->

    <owl:Class rdf:about="http://example.org/bmw#AWD">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Drivetrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#AdvancedADASCar -->

    <owl:Class rdf:about="http://example.org/bmw#AdvancedADASCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasFeature"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#DrivingAssistancePro"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#BMWModel -->

    <owl:Class rdf:about="http://example.org/bmw#BMWModel"/>
    


    <!-- http://example.org/bmw#BodyType -->

    <owl:Class rdf:about="http://example.org/bmw#BodyType"/>
    


    <!-- http://example.org/bmw#Convertible -->

    <owl:Class rdf:about="http://example.org/bmw#Convertible">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Coupe -->

    <owl:Class rdf:about="http://example.org/bmw#Coupe">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Diesel -->

    <owl:Class rdf:about="http://example.org/bmw#Diesel">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Drivetrain -->

    <owl:Class rdf:about="http://example.org/bmw#Drivetrain"/>
    


    <!-- http://example.org/bmw#DrivingAssistancePro -->

    <owl:Class rdf:about="http://example.org/bmw#DrivingAssistancePro"/>
    


    <!-- http://example.org/bmw#Electric -->

    <owl:Class rdf:about="http://example.org/bmw#Electric">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#ElectricCar -->

    <owl:Class rdf:about="http://example.org/bmw#ElectricCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasPowertrain"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#Electric"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://example.org/bmw#PetrolCar"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#FWD -->

    <owl:Class rdf:about="http://example.org/bmw#FWD">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Drivetrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Feature -->

    <owl:Class rdf:about="http://example.org/bmw#Feature"/>
    


    <!-- http://example.org/bmw#Gasoline -->

    <owl:Class rdf:about="http://example.org/bmw#Gasoline">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#GranCoupe -->

    <owl:Class rdf:about="http://example.org/bmw#GranCoupe">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Hatchback -->

    <owl:Class rdf:about="http://example.org/bmw#Hatchback">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#HighPerformanceCar -->

    <owl:Class rdf:about="http://example.org/bmw#HighPerformanceCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://example.org/bmw#hasPerformance"/>
                                <owl:someValuesFrom rdf:resource="http://example.org/bmw#MPerformance"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://example.org/bmw#hasPerformance"/>
                                <owl:someValuesFrom rdf:resource="http://example.org/bmw#MSeries"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#Hybrid -->

    <owl:Class rdf:about="http://example.org/bmw#Hybrid">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#HybridCar -->

    <owl:Class rdf:about="http://example.org/bmw#HybridCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasPowertrain"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#PlugInHybrid"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#MPerformance -->

    <owl:Class rdf:about="http://example.org/bmw#MPerformance">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Performance"/>
        <owl:disjointWith rdf:resource="http://example.org/bmw#MSeries"/>
        <owl:disjointWith rdf:resource="http://example.org/bmw#Standard"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#MSeries -->

    <owl:Class rdf:about="http://example.org/bmw#MSeries">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Performance"/>
        <owl:disjointWith rdf:resource="http://example.org/bmw#Standard"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#OffroadCapableSUV -->

    <owl:Class rdf:about="http://example.org/bmw#OffroadCapableSUV">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasBodyType"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#SUV"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasFeature"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#xDrive"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#Performance -->

    <owl:Class rdf:about="http://example.org/bmw#Performance"/>
    


    <!-- http://example.org/bmw#PetrolCar -->

    <owl:Class rdf:about="http://example.org/bmw#PetrolCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasPowertrain"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#Gasoline"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#PlugInHybrid -->

    <owl:Class rdf:about="http://example.org/bmw#PlugInHybrid">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Powertrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Powertrain -->

    <owl:Class rdf:about="http://example.org/bmw#Powertrain"/>
    


    <!-- http://example.org/bmw#RWD -->

    <owl:Class rdf:about="http://example.org/bmw#RWD">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Drivetrain"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#SUV -->

    <owl:Class rdf:about="http://example.org/bmw#SUV">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
        <owl:disjointWith rdf:resource="http://example.org/bmw#Sedan"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Sedan -->

    <owl:Class rdf:about="http://example.org/bmw#Sedan">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#BodyType"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#Series -->

    <owl:Class rdf:about="http://example.org/bmw#Series"/>
    


    <!-- http://example.org/bmw#Standard -->

    <owl:Class rdf:about="http://example.org/bmw#Standard">
        <rdfs:subClassOf rdf:resource="http://example.org/bmw#Performance"/>
    </owl:Class>
    


    <!-- http://example.org/bmw#StandardCar -->

    <owl:Class rdf:about="http://example.org/bmw#StandardCar">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/bmw#BMWModel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/bmw#hasPerformance"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/bmw#Standard"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://example.org/bmw#ThreeSeriesCar -->

    <owl:Class rdf:about="http://example.org/bmw#ThreeSeriesCar">
